DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/capability
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Concierge Agent
CONCIERGE_ENABLED=true
CONCIERGE_WORKER_ENABLED=true
CONCIERGE_LLM_ENABLED=true
CONCIERGE_EVENT_RETENTION_DAYS=30
CONCIERGE_MONITOR_INTERVAL_SECONDS=90
CONCIERGE_NUDGE_AUTO_GUIDE=false
CONCIERGE_NUDGE_SNOOZE_MINUTES=60
CONCIERGE_NUDGE_MIN_RELIABILITY=0.55
CONCIERGE_NUDGE_SESSION_LIMIT=1
CONCIERGE_NUDGE_COOLDOWN_MINUTES=30
CONCIERGE_FRICTION_INTERVAL_SECONDS=60
CONCIERGE_LEARNING_INTERVAL_SECONDS=3600
CONCIERGE_NUDGE_POLL_HINT_SECONDS=20
CONCIERGE_STRUCTURED_LOGS=true
CONCIERGE_EMBEDDINGS=auto
OTEL_ENABLED=false
