DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/capability
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Vera voice — Sarah + v3 conversational (best natural speech via Text-to-Dialogue API)
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_MODEL=eleven_v3_conversational
# ELEVENLABS_VOICE_STABILITY=0.42
# Fallback faster (less natural): ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_LANGUAGE=en
# Claude cost estimates (USD per million tokens) — match Anthropic Console for your model
# ANTHROPIC_INPUT_PRICE_PER_MTOK=3.0
# ANTHROPIC_OUTPUT_PRICE_PER_MTOK=15.0
# ELEVENLABS_VOICE_SPEED=0.97
# Concierge Agent
CONCIERGE_ENABLED=true
CONCIERGE_WORKER_ENABLED=true
CONCIERGE_LLM_ENABLED=true
CONCIERGE_EVENT_RETENTION_DAYS=30
CONCIERGE_MONITOR_INTERVAL_SECONDS=90
CONCIERGE_NUDGE_AUTO_GUIDE=false
CONCIERGE_NUDGE_SNOOZE_MINUTES=60
CONCIERGE_NUDGE_MIN_RELIABILITY=0.55
CONCIERGE_NUDGE_SESSION_LIMIT=1
CONCIERGE_NUDGE_COOLDOWN_MINUTES=30
CONCIERGE_FRICTION_INTERVAL_SECONDS=60
CONCIERGE_LEARNING_INTERVAL_SECONDS=3600
CONCIERGE_NUDGE_POLL_HINT_SECONDS=20
CONCIERGE_STRUCTURED_LOGS=true
CONCIERGE_EMBEDDINGS=auto
OTEL_ENABLED=false
